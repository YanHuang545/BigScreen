page {
  background: #0b1020;
  color: #e8eefc;
  font-size: 28rpx;
}

.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #0b1020;
}

.card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(232, 201, 138, 0.35);
  border-radius: 20rpx;
  background-color: #1a1430;
  background-image: linear-gradient(180deg, rgba(36, 24, 72, 0.72), rgba(12, 16, 36, 0.92));
}

.h1 {
  font-size: 36rpx;
  font-weight: 600;
  color: #f6e7c4;
  letter-spacing: 2rpx;
}

.muted {
  color: #9aabc8;
}

.gold {
  color: #f0d7a0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chips .chip {
  margin: 0 12rpx 12rpx 0;
}

.chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(158, 176, 214, 0.35);
  color: #c5d2ea;
  background: rgba(255, 255, 255, 0.03);
}

.chip.on {
  color: #1a1408;
  background: #f0d7a0;
  border-color: #f0d7a0;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-2 .card {
  width: 48%;
  box-sizing: border-box;
}

.kpi-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff8ea;
}

.kpi-num text {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #f0d7a0;
}

.btn {
  display: inline-block;
  width: auto;
  margin: 0;
  padding: 0 22rpx;
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 26rpx;
  text-align: center;
  color: #1a1408;
  background: #f0d7a0;
}

.row .btn {
  flex: none;
}

.btn.ghost {
  color: #f0d7a0;
  background: transparent;
  border: 1rpx solid rgba(240, 215, 160, 0.7);
}

.btn.warn {
  color: #fff;
  background: #d4672f;
}
