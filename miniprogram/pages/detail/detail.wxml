<view class="page">
  <view class="chips">
    <view class="chip {{item.id === kind ? 'on' : ''}}" wx:for="{{kinds}}" wx:key="id" data-id="{{item.id}}" bindtap="pickKind">{{item.label}}</view>
  </view>
  <view class="card" wx:for="{{rows}}" wx:key="id">
    <view class="line" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="title">
      <text class="muted">{{cell.title}}</text>
      <text>{{cell.value}}</text>
    </view>
  </view>
</view>
