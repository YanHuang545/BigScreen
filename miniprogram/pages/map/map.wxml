<view class="page">
  <view class="card">
    <view class="row">
      <view>
        <view class="muted">已选</view>
        <view class="place">{{active}}</view>
        <view class="muted">节点 {{node}} · 联系人 {{contact}}</view>
      </view>
      <view class="btn {{touring ? 'warn' : ''}}" bindtap="toggleTour">{{touring ? '停止' : '轮巡'}}</view>
    </view>
  </view>
  <view class="card">
    <view class="section">行政区</view>
    <view class="chips">
      <view class="chip {{item === active ? 'on' : ''}}" wx:for="{{districts}}" wx:key="*this" data-name="{{item}}" bindtap="pick">{{item}}</view>
    </view>
  </view>
  <view class="card">
    <view class="section">重点区域</view>
    <view class="chips">
      <view class="chip {{item === active ? 'on' : ''}}" wx:for="{{businesses}}" wx:key="*this" data-name="{{item}}" bindtap="pick">{{item}}</view>
    </view>
  </view>
</view>
