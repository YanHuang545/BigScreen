<view class="page">
  <view class="card hero">
    <view class="h1">商用密码运行安全指挥中心</view>
    <view class="weather">
      <text>{{weather.label}}</text>
      <text>{{weather.low}}~{{weather.high}}℃</text>
      <text>{{weather.sky}}</text>
      <text>{{weather.wind}} {{weather.speed}}m/s</text>
    </view>
    <view class="row">
      <view class="source" bindtap="onSource">数据：{{source}}{{weather.sample ? ' · 天气为样例' : ''}}</view>
      <view class="gold" bindtap="refresh">刷新</view>
    </view>
    <view class="hint" wx:if="{{hint}}">{{hint}}</view>
  </view>

  <view class="card">
    <picker mode="selector" range="{{cityNames}}" value="{{cityIndex}}" bindchange="onCity">
      <view class="row">
        <view>
          <view class="muted">当前区域</view>
          <view class="place">北京市 / {{cityNames[cityIndex]}}</view>
        </view>
        <text class="gold">切换</text>
      </view>
    </picker>
  </view>

  <view class="grid-2">
    <view class="card kpi" wx:for="{{kpis}}" wx:key="label">
      <view class="kpi-num">{{item.value}}<text>{{item.unit}}</text></view>
      <view class="muted">{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="meta">当前下级节点：<text class="gold">{{node}}</text></view>
    <view class="meta">紧急联系人：<text class="gold">{{contact}}</text></view>
    <view class="calls">
      <view class="btn" data-kind="语音通话" bindtap="dial">语音通话</view>
      <view class="btn ghost" data-kind="视频通话" bindtap="dial">视频通话</view>
    </view>
  </view>
</view>
